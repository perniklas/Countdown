rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function hasValidFields(data) {
      return data.keys().hasAll([
        'title',
        'targetAt',
        'status',
        'theme',
        'themeSettings',
        'createdAt',
        'updatedAt'
      ]) && data.keys().hasOnly([
        'title',
        'targetAt',
        'status',
        'theme',
        'themeSettings',
        'createdAt',
        'updatedAt'
      ]);
    }

    function hasValidThemeSettings(settings) {
      return settings is map
        && settings.keys().hasOnly(['gradientMood'])
        && settings.gradientMood is number
        && settings.gradientMood >= 0
        && settings.gradientMood <= 100;
    }

    function isValidCountdown(data) {
      return hasValidFields(data)
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 80
        && !data.title.matches('^\\s.*')
        && !data.title.matches('.*\\s$')
        && data.targetAt is timestamp
        && data.status in ['active', 'history']
        && data.theme in [
          'aurora',
          'event-horizon',
          'hyperdrive',
          'paper-riot'
        ]
        && hasValidThemeSettings(data.themeSettings)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId}/countdowns/{countdownId} {
      allow read, delete: if isOwner(userId);
      allow create: if isOwner(userId)
        && isValidCountdown(request.resource.data)
        && request.resource.data.status == 'active';
      allow update: if isOwner(userId)
        && isValidCountdown(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
    }
  }
}
